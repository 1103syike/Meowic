# Neon PostgreSQL（免費方案）連線字串
# https://neon.tech → 建立專案 → Connection string
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# JWT 簽章（正式環境請改成隨機長字串）
JWT_SECRET=請改成你自己的密鑰

# Vercel Blob 上傳（Vercel 專案 → Storage → Blob → 建立後自動帶入）
BLOB_READ_WRITE_TOKEN=

# 本機 API port（選用）
API_PORT=3001
