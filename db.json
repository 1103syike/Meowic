  "artists": [
    {
      "id": 1,
      "imgPath": "./mock/artist/artist-1.webp",
      "name": "BigBang",
      "description": "BIGBANG（韓語：빅뱅；日語：ビッグバン）是韓國YG娛樂於2006年推出的男子團體，最初由太陽、G-Dragon、大聲、T.O.P以及勝利五位成員組成，G-Dragon擔任隊長一職。團體以「宇宙大爆炸」為名，意味著將對於韓國音樂界，甚至在全世界帶來爆炸性的影響。官方的歌迷名稱則是「V.I.P」，其意思為「Very Important Person」，是根據第二張單曲《BIGBANG Is V.I.P》命名，有著粉絲是非常重要的人的含義。"
    },
    {
      "id": 2,
      "imgPath": "./mock/artist/artist-2.jpg",
      "name": "PLAVE",
      "description": "PLAVE（韓語：플레이브；日語：プレイブ）是韓國VLAST於2023年推出的虛擬男子團體，由五位成員組成，分別為諾亞、藝俊、斑比、銀虎與河玟，並由藝俊擔任隊長。"
    },
    {
      "id": 3,
      "imgPath": "./mock/artist/artist-3.jpg",
      "name": "澤野弘之",
      "description": "澤野弘之，日本作曲家、編曲家，出生於東京都。代表配樂作品有電視劇《醫龍》系列、動畫《機動戰士鋼彈UC》、《罪惡王冠》、《進擊的巨人》、《KILL la KILL》、《青之驅魔師》、《終結的熾天使》、《七大罪》等。"
    },
    {
      "id": 4,
      "imgPath": "./mock/artist/DIAN.jpg",
      "name": "DIAN",
      "description": "以獨特聲線與細膩情感受到關注的韓國創作者型歌手。DIAN 擅長將日常情緒與青春感融入音樂之中，結合柔和旋律、輕電子與 K-Indie 氛圍，打造帶有深夜感性的作品風格。除了音樂創作外，也透過 YouTube 分享生活與創作日常，以真實自然的魅力累積全球粉絲喜愛。"
    },
    {
      "name": "崔叡娜",
      "imgPath": "http://localhost:3000/mock/upload/1779330917653-785331865.jpg",
      "description": "崔叡娜（韓語：최예나，英語：Yena Choi，日語：チェ・イェナ，1999年9月29日—），韓國女歌手、演員、主持人，早期曾被音譯為崔藝娜，所屬經紀公司為YH娛樂。曾為期間限定女子團體IZ*ONE成員，團內擔任主rap、領舞、領唱。現以SOLO歌手身分活動。官方粉絲名稱為「Jigumi（지구미）」。",
      "id": 5
    },
    {
      "name": "Stream Degauss",
      "imgPath": "http://localhost:3000/mock/upload/1779332508447-180297057.jpg",
      "description": "Stream Degauss 本名不詳，在數位音樂界被稱為「音頻洗滌者」。Degauss（消磁）原本是指清除磁體或螢幕雜訊的過程；而他/她擅長在紛亂的數位洪流（Stream）中，用強烈的重低音與電子節奏，將聽眾大腦中的焦慮與雜訊徹底「消磁」，只留下最純粹的音樂共振。",
      "id": 6
    },
    {
      "name": "Undertale",
      "imgPath": "http://localhost:3000/mock/upload/1779333500704-393656202.png",
      "description": "《Undertale》是一款由獨立遊戲製作人Toby Fox開發的電子角色扮演遊戲，玩家在遊戲中操控一名誤闖地底世界的人類孩童，在這片隱藏於地表之下、由魔法結界隔絕的廣大空間展開冒險，試圖回到地面。旅途中，玩家會遇見各式各樣的怪物，其中部分會引發戰鬥。",
      "id": 7
    },
    {
      "name": "宋佳野",
      "imgPath": "http://localhost:3000/mock/upload/1779557636107-219562376.png",
      "description": "「宋佳野」是一位近來在各大社群平台（如 Threads、TikTok 等）備受討論的音樂人，以翻唱及詮釋帶有抒情、情感豐沛的流行曲目聞名。",
      "id": 8
    }
  ],
